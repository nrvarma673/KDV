rules_version = '2';

// ==========================================================================
// Cloud Storage Security Rules — KDV Life Journey
//
// Deploy via: Firebase Console > Storage > Rules tab > paste this file's
// contents > Publish.  (Or via Firebase CLI: firebase deploy --only storage:rules)
//
// Design: all photo files live under /photos/{yearId}/{fileName}. Only a
// logged-in (authenticated) user may read or write them — the childhood
// photos themselves are never publicly accessible, only the home page
// bio/achievements text is public.
// ==========================================================================

service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{yearId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
