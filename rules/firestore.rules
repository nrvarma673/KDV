rules_version = '2';

// ==========================================================================
// Firestore Security Rules — KDV Life Journey
//
// Deploy via: Firebase Console > Firestore Database > Rules tab > paste this
// file's contents > Publish.  (Or via Firebase CLI: firebase deploy --only firestore:rules)
//
// Design:
//   - "achievements" is public read-only content shown on the home page.
//   - "years" and the nested "photos" sub-collection hold the private family
//     photo timeline — readable ONLY by a logged-in (authenticated) user.
//   - "settings" holds internal app flags (e.g. forced password change) —
//     readable/writable only by a logged-in user.
//   - Because this app has exactly one admin/family account, "authenticated"
//     effectively means "the family". If you later add more logins and want
//     to restrict write access to a specific person only, replace
//     `request.auth != null` with `request.auth.uid == "THAT_USER_UID"`.
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /years/{yearId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /photos/{photoId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }

    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
